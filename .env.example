# ============================================================
# AADA — Docker Compose environment
#   cp .env.example .env   then fill in the required (✱) values
# ============================================================

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=aada
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=aada_db

# ── Backend ───────────────────────────────────────────
# ✱ REQUIRED — generate with:  openssl rand -hex 32
SECRET_KEY=
APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the SPA's public URL)
ALLOWED_ORIGINS=http://localhost:8080
UVICORN_WORKERS=2

# ── Bootstrap admin (so you can log in on first boot) ─
DEFAULT_ADMIN_EMAIL=admin@aada.io
# ✱ REQUIRED
DEFAULT_ADMIN_PASSWORD=change_me_admin_password

# ── AI / RAG (optional — offline fallbacks used if unset) ─
OPENAI_API_KEY=
RAG_COLLECTION=aada_knowledge

# ── Threat-intel integrations (optional) ──────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=

# ── Host port mappings ────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
