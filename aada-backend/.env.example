# Database
DATABASE_URL=postgresql+asyncpg://aada:secret@localhost:5432/aada_db

# Auth
SECRET_KEY=changeme_run_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
DEBUG=true
LOG_FORMAT=console
LOG_LEVEL=DEBUG

# Auth seeding — roles (viewer/analyst/admin) are seeded on startup when AUTO_SEED=true.
# Optionally bootstrap an admin account so you can log in immediately.
AUTO_SEED=true
DEFAULT_ADMIN_EMAIL=admin@aada.io
DEFAULT_ADMIN_PASSWORD=changeme_admin_password

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# AI / RAG (leave OPENAI_API_KEY unset to use offline hashing embeddings in dev)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
# ChromaDB: set CHROMA_PERSIST_DIR for a local file store, OR CHROMA_HOST/PORT for
# a server. Leave all unset to use the in-memory store (dev/test only).
CHROMA_PERSIST_DIR=./.chroma
CHROMA_HOST=
CHROMA_PORT=8000
RAG_COLLECTION=aada_knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# External threat-intel APIs (optional — clients enable themselves when a key is set).
# NEVER commit real keys; inject via secrets manager in production.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=

# Background / cache (later phases)
REDIS_URL=redis://localhost:6379
